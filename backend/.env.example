# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
MONGO_DB=swm

# JWT secret for authentication (generate a secure random string)
JWT_SECRET=your-secret-key-here-change-this-in-production

# Optional: Device API key for ESP32 to authenticate
# DEVICE_KEY=your-device-key

# Email settings for OTP (optional - leave blank for console test mode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
# ALLOWED_EMAIL_DOMAIN=yourdomain.edu

# SMS provider: console (default, test only) | fast2sms | twilio
SMS_PROVIDER=console

# Twilio settings (if using Twilio)
# TWILIO_SID=your-twilio-sid
# TWILIO_TOKEN=your-twilio-token
# TWILIO_FROM=+1234567890

# Fast2SMS settings (if using Fast2SMS)
# FAST2SMS_KEY=your-api-key
# FAST2SMS_ROUTE=q
